{
  "name": "chordvault",
  "version": "1.27.0",
  "description": "Self-hosted chord sheet manager with transpose",
  "author": "Rudy Samuel",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/rusahu/chordvault.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"NODE_ENV=development node server.js\" \"cd frontend && npm run dev\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"*.js\" \"lib/**/*.js\" \"routes/**/*.js\" \"shared/**/*.{mjs,json}\"",
    "format:check": "prettier --check \"*.js\" \"lib/**/*.js\" \"routes/**/*.js\" \"shared/**/*.{mjs,json}\"",
    "test": "node --test test/*.test.js",
    "prepare": "husky || true"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "chordsheetjs": "^18.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.4",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "*.js": "eslint",
    "lib/**/*.js": "eslint",
    "routes/**/*.js": "eslint",
    "frontend/src/**/*.{ts,tsx}": "cd frontend && npx eslint",
    "shared/**/*.mjs": "eslint"
  }
}
